# ---- LLM API Keys (Kisi ek ki key daalo) ----
# Option A: Google Gemini (Free tier available)
GEMINI_API_KEY=
MODEL=gemini/gemini-1.5-flash
# RESEARCH_MODEL=gemini/gemini-1.5-flash
# VERIFIER_MODEL=gemini/gemini-1.5-flash

# Option B: Anthropic Claude
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# MODEL=claude-sonnet-5-5
# RESEARCH_MODEL=claude-haiku-5-5
# VERIFIER_MODEL=claude-haiku-5-5

# PRICE_IN_PER_M=0.15        # cost estimate: Gemini 1.5 Flash (~$0.15 in / $0.60 out)
# PRICE_OUT_PER_M=0.60
# CONCURRENCY=3
# MAX_RETRIES=2

# ---- Stage 5 ----
# EMBEDDER=hashing          # default: offline, lexical.  "sbert" = sentence-transformers (pip install sentence-transformers)
# MEMORY_MIN_SIM=0.25       # embedder badlo to ye tune karo (sbert ke liye ~0.5 se shuru karo)
# DOC_MIN_SIM=0.15
# MEMORY_MAX_AGE_DAYS=90
# CHROMA_DIR=data/chroma
# KG_PATH=data/kg.json

# ---- API (uvicorn app.api:app) ----
# API_KEY=change-me         # set karo to har request me X-API-Key header chahiye
# CORS_ORIGINS=http://localhost:8501,http://localhost:3000

# ---- Stage 6 ----
# REPORT_LANGUAGE=auto      # auto (query se pehchano) / en / hi / hinglish
# JUDGE_MODEL=              # eval ka LLM-as-judge. Behtar hai generator se ALAG model (self-preference bias)
# PDF_FONT_DIR=static/fonts # Noto Sans + Noto Sans Devanagari (bundled, OFL license)
# SBERT_MODEL=paraphrase-multilingual-MiniLM-L12-v2   # EMBEDDER=sbert ke saath Hindi<->English memory/PDF search (test nahi hua)
